{
  "name": "online-food-ordering-api",
  "version": "1.0.0",
  "description": "Online Food Ordering REST API Testing Using Cypress",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "cypress:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "report:merge": "mochawesome-merge results/mochawesome/*.json -o results/mochawesome-bundle.json",
    "report:generate": "marge results/mochawesome-bundle.json -f index -o results",
    "report": "npm run report:merge && npm run report:generate"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "cypress": "^13.13.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "allowScripts": {
    "cypress@13.17.0": true
  }
}
